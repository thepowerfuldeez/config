#!/usr/bin/env python3
import argparse
import statistics
import subprocess
import time


def percentile(values, pct):
    if not values:
        return 0.0
    values = sorted(values)
    k = (len(values) - 1) * (pct / 100.0)
    f = int(k)
    c = min(f + 1, len(values) - 1)
    if f == c:
        return values[f]
    return values[f] + (values[c] - values[f]) * (k - f)


def run_once(shell, login):
    args = [shell]
    if login:
        args.append("-l")
    args += ["-i", "-c", "exit"]
    start = time.perf_counter()
    subprocess.run(
        args,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return (time.perf_counter() - start) * 1000.0


def main():
    parser = argparse.ArgumentParser(
        description="Measure interactive zsh startup time."
    )
    parser.add_argument("--runs", type=int, default=30, help="Number of measured runs")
    parser.add_argument(
        "--warmup", type=int, default=3, help="Warmup runs to discard"
    )
    parser.add_argument(
        "--login",
        action="store_true",
        help="Include login shell startup files",
    )
    parser.add_argument(
        "--shell",
        default="/bin/zsh",
        help="Path to zsh binary",
    )
    args = parser.parse_args()

    for _ in range(max(args.warmup, 0)):
        run_once(args.shell, args.login)

    samples = [run_once(args.shell, args.login) for _ in range(max(args.runs, 1))]

    mean = statistics.mean(samples)
    p50 = percentile(samples, 50)
    p95 = percentile(samples, 95)
    min_v = min(samples)
    max_v = max(samples)

    mode = "login" if args.login else "interactive"
    print(f"mode: {mode}")
    print(f"runs: {len(samples)} (warmup {args.warmup})")
    print(
        "ms: mean={:.1f} p50={:.1f} p95={:.1f} min={:.1f} max={:.1f}".format(
            mean, p50, p95, min_v, max_v
        )
    )


if __name__ == "__main__":
    main()
