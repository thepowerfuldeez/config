# >>> config repo >>>
# Keep PATH changes early.
if [[ -r "$HOME/.local/bin/env" ]]; then
  . "$HOME/.local/bin/env"
fi

# Homebrew prefix for plugin paths; use a safe fallback for non-login shells.
HOMEBREW_PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"

# Aliases
if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
fi
alias pip="uv pip"
alias python="python3"
alias vim="nvim"

# zsh-autosuggestions
if [[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# Docker CLI completions
if [[ -d "$HOME/.docker/completions" ]]; then
  fpath=("$HOME/.docker/completions" $fpath)
fi

autoload -Uz compinit
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"
compinit -C -d "$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR"

# fzf (fast fuzzy finder)
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND="fd --type f"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type d"
fi
if [[ -r "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh" ]]; then
  source "$HOMEBREW_PREFIX/opt/fzf/shell/completion.zsh"
fi
if [[ -r "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh" ]]; then
  source "$HOMEBREW_PREFIX/opt/fzf/shell/key-bindings.zsh"
fi

# zoxide (fast directory jump)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# Nebius CLI path
if [[ -f "$HOME/.nebius/path.zsh.inc" ]]; then
  source "$HOME/.nebius/path.zsh.inc"
fi
# <<< config repo <<<
