// Fast, coherent VS Code keymap for the main profile.
[
    { "key": "alt+cmd+l", "command": "ruff.executeFormat" },

    { "key": "cmd+w", "command": "-workbench.action.closeWindow", "when": "!editorIsOpen && !multipleEditorGroups" },
    { "key": "shift+cmd+w", "command": "-workbench.action.closeWindow" },
    { "key": "shift+cmd+w", "command": "workbench.action.closeActiveEditor" },

    { "key": "alt+cmd+i", "command": "git.commit" },
    { "key": "alt+cmd+p", "command": "git.push" },

    { "key": "cmd+d", "command": "editor.action.copyLinesDownAction", "when": "editorTextFocus && !editorReadonly" },
    { "key": "shift+alt+down", "command": "-editor.action.copyLinesDownAction", "when": "editorTextFocus && !editorReadonly" },
    { "key": "cmd+d", "command": "-editor.action.addSelectionToNextFindMatch", "when": "editorFocus" },
    { "key": "cmd+k d", "command": "-workbench.files.action.compareWithSaved" },
    { "key": "cmd+k cmd+d", "command": "-editor.action.moveSelectionToNextFindMatch", "when": "editorFocus" },
    { "key": "cmd+d", "command": "-notebook.addFindMatchToSelection", "when": "config.notebook.multiCursor.enabled && notebookCellEditorFocused && activeEditor == 'workbench.editor.notebook'" },
    { "key": "shift+cmd+d", "command": "-workbench.view.debug", "when": "viewContainer.workbench.view.debug.enabled" },

    { "key": "alt+cmd+left", "command": "workbench.action.navigateBack", "when": "canNavigateBack" },
    { "key": "ctrl+-", "command": "-workbench.action.navigateBack", "when": "canNavigateBack" },
    { "key": "alt+cmd+right", "command": "workbench.action.navigateForward", "when": "canNavigateForward" },
    { "key": "ctrl+shift+-", "command": "-workbench.action.navigateForward", "when": "canNavigateForward" },
    { "key": "alt+cmd+right", "command": "-workbench.action.nextEditor" },
    { "key": "cmd+k alt+cmd+right", "command": "-workbench.action.nextEditorInGroup" },
    { "key": "shift+alt+cmd+right", "command": "-cursorColumnSelectRight", "when": "textInputFocus" },
    { "key": "ctrl+alt+cmd+right", "command": "-quickInput.acceptInBackground", "when": "cursorAtEndOfQuickInputBox && inQuickInput && quickInputType == 'quickPick' || inQuickInput && !inputFocus && quickInputType == 'quickPick'" },
    { "key": "alt+cmd+right", "command": "-quickInput.acceptInBackground", "when": "cursorAtEndOfQuickInputBox && inQuickInput && quickInputType == 'quickPick' || inQuickInput && !inputFocus && quickInputType == 'quickPick'" },
    { "key": "alt+cmd+left", "command": "-workbench.action.previousEditor" },
    { "key": "cmd+k alt+cmd+left", "command": "-workbench.action.previousEditorInGroup" },
    { "key": "shift+alt+cmd+left", "command": "-cursorColumnSelectLeft", "when": "textInputFocus" },

    { "key": "shift+cmd+j", "command": "-workbench.action.search.toggleQueryDetails", "when": "inSearchEditor || searchViewletFocus" },
    { "key": "shift+cmd+j", "command": "jupyter.createnewnotebook" },
    { "key": "ctrl+alt+m", "command": "workbench.action.toggleMaximizedPanel", "when": "!terminalFocus" },
    { "key": "ctrl+`", "command": "workbench.action.closePanel", "when": "terminalFocus" },
    { "key": "ctrl+alt+m", "command": "workbench.action.terminal.toggleTerminal", "when": "terminalFocus" },
    { "key": "alt+enter", "command": "editor.action.quickFix", "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly" },
    { "key": "cmd+.", "command": "-editor.action.quickFix", "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly" },

    { "key": "cmd+e", "command": "workbench.files.action.focusFilesExplorer" },
    { "key": "alt+cmd+e", "command": "workbench.files.action.showActiveFileInExplorer" },

    { "key": "cmd+enter", "command": "notebook.cell.insertCodeCellBelow", "when": "notebookEditorFocused" },
    { "key": "shift+cmd+enter", "command": "notebook.cell.insertCodeCellAbove", "when": "notebookEditorFocused" },
    { "key": "shift+alt+cmd+n", "command": "notebook.cell.insertCodeCellAbove", "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+enter", "command": "notebook.cell.executeAndInsertBelow", "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+j", "command": "notebook.focusNextEditor", "when": "notebookEditorFocused" },
    { "key": "ctrl+shift+k", "command": "notebook.focusPreviousEditor", "when": "notebookEditorFocused" },
    { "key": "shift+v", "command": "notebook.cell.pasteAbove", "when": "notebookEditorFocused && !inputFocus" },

    { "key": "shift+cmd+d", "command": "workbench.view.debug" },
    { "key": "ctrl+alt+d", "command": "workbench.action.debug.start" },
    { "key": "ctrl+alt+b", "command": "editor.debug.action.toggleBreakpoint" },
    { "key": "ctrl+alt+c", "command": "workbench.action.debug.continue", "when": "inDebugMode" },
    { "key": "ctrl+alt+r", "command": "workbench.action.debug.restart", "when": "inDebugMode" },
    { "key": "ctrl+alt+.", "command": "workbench.action.debug.stop", "when": "inDebugMode" },
    { "key": "ctrl+alt+j", "command": "workbench.action.debug.stepOver", "when": "inDebugMode" },
    { "key": "ctrl+alt+k", "command": "workbench.action.debug.stepInto", "when": "inDebugMode" },
    { "key": "ctrl+alt+l", "command": "workbench.action.debug.stepOut", "when": "inDebugMode" }
]
