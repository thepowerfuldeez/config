{
  "name": "main",
  "settings": "{\"settings\": \"{\\n  \\\"workbench.colorTheme\\\": \\\"Solarized Dark\\\",\\n  \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n  \\\"window.commandCenter\\\": true,\\n  \\\"terminal.integrated.inheritEnv\\\": false,\\n  \\\"git.autofetch\\\": true,\\n  \\\"editor.fontSize\\\": 13,\\n  \\\"editor.fontFamily\\\": \\\"JetBrains Mono, Monaco, 'Courier New', monospace\\\",\\n  \\\"editor.fontLigatures\\\": true,\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"remote.autoForwardPortsSource\\\": \\\"hybrid\\\",\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"explorer.confirmDragAndDrop\\\": false,\\n  \\\"redhat.telemetry.enabled\\\": true,\\n  \\\"git.confirmSync\\\": false,\\n  \\\"terminal.integrated.cwd\\\": \\\"${fileDirname}\\\",\\n  \\\"git.replaceTagsWhenPull\\\": true,\\n  \\\"python.analysis.exclude\\\": [\\n    \\\"**/__pycache__\\\",\\n    \\\".git\\\"\\n  ],\\n  \\\"python.analysis.typeCheckingMode\\\": \\\"standard\\\",\\n  \\\"gitlens.launchpad.indicator.enabled\\\": false,\\n  \\\"editor.accessibilitySupport\\\": \\\"on\\\",\\n  \\\"workbench.editorAssociations\\\": {\\n    \\\"*.md\\\": \\\"vscode.markdown.editor\\\"\\n  },\\n  \\\"jupyter.askForKernelRestart\\\": false,\\n  \\\"terminal.external.osxExec\\\": \\\"Ghostty.app\\\"\\n}\\n\"}",
  "keybindings": "{\"keybindings\": \"// Fast, coherent VS Code keymap for the main profile.\\n[\\n    { \\\"key\\\": \\\"alt+cmd+l\\\", \\\"command\\\": \\\"ruff.executeFormat\\\" },\\n\\n    { \\\"key\\\": \\\"cmd+w\\\", \\\"command\\\": \\\"-workbench.action.closeWindow\\\", \\\"when\\\": \\\"!editorIsOpen && !multipleEditorGroups\\\" },\\n    { \\\"key\\\": \\\"shift+cmd+w\\\", \\\"command\\\": \\\"-workbench.action.closeWindow\\\" },\\n    { \\\"key\\\": \\\"shift+cmd+w\\\", \\\"command\\\": \\\"workbench.action.closeActiveEditor\\\" },\\n\\n    { \\\"key\\\": \\\"alt+cmd+i\\\", \\\"command\\\": \\\"git.commit\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+p\\\", \\\"command\\\": \\\"git.push\\\" },\\n\\n    { \\\"key\\\": \\\"cmd+d\\\", \\\"command\\\": \\\"editor.action.copyLinesDownAction\\\", \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\" },\\n    { \\\"key\\\": \\\"shift+alt+down\\\", \\\"command\\\": \\\"-editor.action.copyLinesDownAction\\\", \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\" },\\n    { \\\"key\\\": \\\"cmd+d\\\", \\\"command\\\": \\\"-editor.action.addSelectionToNextFindMatch\\\", \\\"when\\\": \\\"editorFocus\\\" },\\n    { \\\"key\\\": \\\"cmd+k d\\\", \\\"command\\\": \\\"-workbench.files.action.compareWithSaved\\\" },\\n    { \\\"key\\\": \\\"cmd+k cmd+d\\\", \\\"command\\\": \\\"-editor.action.moveSelectionToNextFindMatch\\\", \\\"when\\\": \\\"editorFocus\\\" },\\n    { \\\"key\\\": \\\"cmd+d\\\", \\\"command\\\": \\\"-notebook.addFindMatchToSelection\\\", \\\"when\\\": \\\"config.notebook.multiCursor.enabled && notebookCellEditorFocused && activeEditor == 'workbench.editor.notebook'\\\" },\\n    { \\\"key\\\": \\\"shift+cmd+d\\\", \\\"command\\\": \\\"-workbench.view.debug\\\", \\\"when\\\": \\\"viewContainer.workbench.view.debug.enabled\\\" },\\n\\n    { \\\"key\\\": \\\"alt+cmd+left\\\", \\\"command\\\": \\\"workbench.action.navigateBack\\\", \\\"when\\\": \\\"canNavigateBack\\\" },\\n    { \\\"key\\\": \\\"ctrl+-\\\", \\\"command\\\": \\\"-workbench.action.navigateBack\\\", \\\"when\\\": \\\"canNavigateBack\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+right\\\", \\\"command\\\": \\\"workbench.action.navigateForward\\\", \\\"when\\\": \\\"canNavigateForward\\\" },\\n    { \\\"key\\\": \\\"ctrl+shift+-\\\", \\\"command\\\": \\\"-workbench.action.navigateForward\\\", \\\"when\\\": \\\"canNavigateForward\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+right\\\", \\\"command\\\": \\\"-workbench.action.nextEditor\\\" },\\n    { \\\"key\\\": \\\"cmd+k alt+cmd+right\\\", \\\"command\\\": \\\"-workbench.action.nextEditorInGroup\\\" },\\n    { \\\"key\\\": \\\"shift+alt+cmd+right\\\", \\\"command\\\": \\\"-cursorColumnSelectRight\\\", \\\"when\\\": \\\"textInputFocus\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+cmd+right\\\", \\\"command\\\": \\\"-quickInput.acceptInBackground\\\", \\\"when\\\": \\\"cursorAtEndOfQuickInputBox && inQuickInput && quickInputType == 'quickPick' || inQuickInput && !inputFocus && quickInputType == 'quickPick'\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+right\\\", \\\"command\\\": \\\"-quickInput.acceptInBackground\\\", \\\"when\\\": \\\"cursorAtEndOfQuickInputBox && inQuickInput && quickInputType == 'quickPick' || inQuickInput && !inputFocus && quickInputType == 'quickPick'\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+left\\\", \\\"command\\\": \\\"-workbench.action.previousEditor\\\" },\\n    { \\\"key\\\": \\\"cmd+k alt+cmd+left\\\", \\\"command\\\": \\\"-workbench.action.previousEditorInGroup\\\" },\\n    { \\\"key\\\": \\\"shift+alt+cmd+left\\\", \\\"command\\\": \\\"-cursorColumnSelectLeft\\\", \\\"when\\\": \\\"textInputFocus\\\" },\\n\\n    { \\\"key\\\": \\\"shift+cmd+j\\\", \\\"command\\\": \\\"-workbench.action.search.toggleQueryDetails\\\", \\\"when\\\": \\\"inSearchEditor || searchViewletFocus\\\" },\\n    { \\\"key\\\": \\\"shift+cmd+j\\\", \\\"command\\\": \\\"jupyter.createnewnotebook\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+m\\\", \\\"command\\\": \\\"workbench.action.toggleMaximizedPanel\\\", \\\"when\\\": \\\"!terminalFocus\\\" },\\n    { \\\"key\\\": \\\"ctrl+`\\\", \\\"command\\\": \\\"workbench.action.closePanel\\\", \\\"when\\\": \\\"terminalFocus\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+m\\\", \\\"command\\\": \\\"workbench.action.terminal.toggleTerminal\\\", \\\"when\\\": \\\"terminalFocus\\\" },\\n    { \\\"key\\\": \\\"alt+enter\\\", \\\"command\\\": \\\"editor.action.quickFix\\\", \\\"when\\\": \\\"editorHasCodeActionsProvider && textInputFocus && !editorReadonly\\\" },\\n    { \\\"key\\\": \\\"cmd+.\\\", \\\"command\\\": \\\"-editor.action.quickFix\\\", \\\"when\\\": \\\"editorHasCodeActionsProvider && textInputFocus && !editorReadonly\\\" },\\n\\n    { \\\"key\\\": \\\"cmd+e\\\", \\\"command\\\": \\\"workbench.files.action.focusFilesExplorer\\\" },\\n    { \\\"key\\\": \\\"alt+cmd+e\\\", \\\"command\\\": \\\"workbench.files.action.showActiveFileInExplorer\\\" },\\n\\n    { \\\"key\\\": \\\"cmd+enter\\\", \\\"command\\\": \\\"notebook.cell.insertCodeCellBelow\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"shift+cmd+enter\\\", \\\"command\\\": \\\"notebook.cell.insertCodeCellAbove\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"shift+alt+cmd+n\\\", \\\"command\\\": \\\"notebook.cell.insertCodeCellAbove\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"ctrl+shift+enter\\\", \\\"command\\\": \\\"notebook.cell.executeAndInsertBelow\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"ctrl+shift+j\\\", \\\"command\\\": \\\"notebook.focusNextEditor\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"ctrl+shift+k\\\", \\\"command\\\": \\\"notebook.focusPreviousEditor\\\", \\\"when\\\": \\\"notebookEditorFocused\\\" },\\n    { \\\"key\\\": \\\"shift+v\\\", \\\"command\\\": \\\"notebook.cell.pasteAbove\\\", \\\"when\\\": \\\"notebookEditorFocused && !inputFocus\\\" },\\n\\n    { \\\"key\\\": \\\"shift+cmd+d\\\", \\\"command\\\": \\\"workbench.view.debug\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+d\\\", \\\"command\\\": \\\"workbench.action.debug.start\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+b\\\", \\\"command\\\": \\\"editor.debug.action.toggleBreakpoint\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+c\\\", \\\"command\\\": \\\"workbench.action.debug.continue\\\", \\\"when\\\": \\\"inDebugMode\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+r\\\", \\\"command\\\": \\\"workbench.action.debug.restart\\\", \\\"when\\\": \\\"inDebugMode\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+.\\\", \\\"command\\\": \\\"workbench.action.debug.stop\\\", \\\"when\\\": \\\"inDebugMode\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+j\\\", \\\"command\\\": \\\"workbench.action.debug.stepOver\\\", \\\"when\\\": \\\"inDebugMode\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+k\\\", \\\"command\\\": \\\"workbench.action.debug.stepInto\\\", \\\"when\\\": \\\"inDebugMode\\\" },\\n    { \\\"key\\\": \\\"ctrl+alt+l\\\", \\\"command\\\": \\\"workbench.action.debug.stepOut\\\", \\\"when\\\": \\\"inDebugMode\\\" }\\n]\\n\", \"platform\": 1}",
  "extensions": "[{\"identifier\": {\"id\": \"alex-pex.theme-darkula\"}}, {\"identifier\": {\"id\": \"antfu.pnpm-catalog-lens\"}}, {\"identifier\": {\"id\": \"bazelbuild.vscode-bazel\"}}, {\"identifier\": {\"id\": \"bradlc.vscode-tailwindcss\"}}, {\"identifier\": {\"id\": \"charliermarsh.ruff\"}}, {\"identifier\": {\"id\": \"eamodio.gitlens\"}}, {\"identifier\": {\"id\": \"emilast.logfilehighlighter\"}}, {\"identifier\": {\"id\": \"esbenp.prettier-vscode\"}}, {\"identifier\": {\"id\": \"github.vscode-github-actions\"}}, {\"identifier\": {\"id\": \"golang.go\"}}, {\"identifier\": {\"id\": \"james-yu.latex-workshop\"}}, {\"identifier\": {\"id\": \"mohsen1.prettify-json\"}}, {\"identifier\": {\"id\": \"ms-azuretools.vscode-containers\"}}, {\"identifier\": {\"id\": \"ms-azuretools.vscode-docker\"}}, {\"identifier\": {\"id\": \"ms-kubernetes-tools.vscode-kubernetes-tools\"}}, {\"identifier\": {\"id\": \"ms-python.debugpy\"}}, {\"identifier\": {\"id\": \"ms-python.python\"}}, {\"identifier\": {\"id\": \"ms-python.vscode-pylance\"}}, {\"identifier\": {\"id\": \"ms-python.vscode-python-envs\"}}, {\"identifier\": {\"id\": \"ms-toolsai.datawrangler\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter-keymap\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter-renderers\"}}, {\"identifier\": {\"id\": \"ms-toolsai.vscode-jupyter-cell-tags\"}}, {\"identifier\": {\"id\": \"ms-toolsai.vscode-jupyter-slideshow\"}}, {\"identifier\": {\"id\": \"ms-vscode-remote.remote-containers\"}}, {\"identifier\": {\"id\": \"ms-vscode-remote.remote-ssh\"}}, {\"identifier\": {\"id\": \"ms-vscode-remote.remote-ssh-edit\"}}, {\"identifier\": {\"id\": \"ms-vscode.remote-explorer\"}}, {\"identifier\": {\"id\": \"ms-vscode.remote-server\"}}, {\"identifier\": {\"id\": \"nonoroazoro.syncing\"}}, {\"identifier\": {\"id\": \"openai.chatgpt\"}}, {\"identifier\": {\"id\": \"redhat.vscode-yaml\"}}, {\"identifier\": {\"id\": \"shd101wyy.markdown-preview-enhanced\"}}, {\"identifier\": {\"id\": \"svelte.svelte-vscode\"}}, {\"identifier\": {\"id\": \"tamasfe.even-better-toml\"}}, {\"identifier\": {\"id\": \"tomoki1207.pdf\"}}, {\"identifier\": {\"id\": \"vitest.explorer\"}}, {\"identifier\": {\"id\": \"vscodevim.vim\"}}]"
